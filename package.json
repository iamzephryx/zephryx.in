{
  "name": "zephryx-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Zephryx \u2014 Penetration Testing / Offensive Security portfolio",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-links.mjs",
    "start": "npx serve@latest out",
    "lint": "next lint",
    "preview": "npm run build && npx wrangler dev",
    "deploy": "npm run build && npx wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^15.0.7",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3",
    "wrangler": "^4.34.0"
  },
  "engines": {
    "node": ">=20"
  }
}
