{
  // The app's tsconfig excludes worker/ — it targets the DOM and Next's JSX,
  // neither of which describes a Cloudflare Worker. That exclusion meant
  // `tsc --noEmit` silently skipped the Worker entirely, so a type error there
  // only surfaced at deploy time in Cloudflare's own build.
  //
  // This config typechecks the Worker on its own terms. `npm run typecheck`
  // runs both.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022", "WebWorker"],
    "jsx": "preserve",
    "noEmit": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022"
  },
  "include": ["worker/**/*.ts"],
  "exclude": ["node_modules", "out", "src", ".next"]
}
