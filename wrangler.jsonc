{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zephryx-in",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-06",
  "vars": {
    "CONTACT_TO": "contact@zephryx.in",
    "CONTACT_FROM": "Zephryx <noreply@mail.zephryx.in>",
    "LEAD_TO": "hello@security.zephryx.in",
    "LEAD_FROM": "Zephryx Security <noreply@mail.zephryx.in>"
  },

  // Carried over verbatim from the Zephryx-Security Worker along with
  // /api/quote. The ids are the same namespaces, so leads written before the
  // consolidation stay readable after it — a new namespace would strand them.
  "kv_namespaces": [
    { "binding": "LEADS", "id": "677a4d26c51b4ca0b35a8d3785c6dccf" },
    { "binding": "LEADS_RL", "id": "1513048abd0f4cffa768ee444236d280" }
  ],

  // The public address, pinned here rather than left as dashboard-only state,
  // so the hostname the portfolio hub answers on is reproducible from this repo.
  // `custom_domain: true` has Cloudflare own the DNS record and certificate;
  // re-declaring an already-attached domain is a no-op.
  "routes": [
    {
      "pattern": "zephryx.in",
      "custom_domain": true
    }
  ],

  // Both of these default to TRUE when absent, and wrangler re-applies that
  // default on every deploy — so switching them off in the dashboard alone
  // gets silently undone by the next push. Stated here so config and
  // dashboard agree and stay agreeing.
  //
  // workers_dev off: this site answers on zephryx.in and nowhere else. A
  // second hostname serving identical content is duplicate content.
  //
  // preview_urls on: this is what puts the per-commit and per-branch preview
  // links on a pull request, which is how a change gets eyeballed before it
  // reaches the live domain. Worth keeping.
  "workers_dev": false,
  "preview_urls": true,

  "assets": {
    "directory": "out",
    "binding": "ASSETS",

    // Scoped, not blanket. The Worker script runs for the two form endpoints
    // and nothing else; every content route is served straight from the asset
    // layer, so a parse error or a module-scope throw in worker/index.ts cannot
    // take the site down. The try/catch in that file cannot catch that class of
    // failure, which is exactly why this is scoped rather than left at `true`.
    //
    // Prerequisites, both done: the /connect and /contact redirects moved to
    // public/_redirects (applied by the asset layer), and MAINTENANCE was
    // rescoped to gate the endpoints rather than the whole site.
    //
    // Anything added to this Worker that must see a content request needs this
    // widened again — which should be a deliberate decision, not a reflex.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
